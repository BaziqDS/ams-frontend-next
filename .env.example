# Copy to .env.local and replace example domains before building.
# NEXT_PUBLIC_* values are public and embedded at build time. Rebuild after edits.
NEXT_PUBLIC_API_URL=https://api.example.com
# External copilot service, if used; this service is deployed separately.
NEXT_PUBLIC_COPILOT_URL=https://copilot.example.com

# Optional voice integrations. These keys stay on the Next.js server.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=ur
# Optional; omit to use the built-in AMS transcription prompt.
# GROQ_STT_PROMPT=
GOOGLE_TRANSLATE_API_KEY=
